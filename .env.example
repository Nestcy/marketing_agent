# ---------------------------------------------------------
# Copy to .env for local dev. On Railway, set these as service
# Variables (shared across the web / worker / beat services).
# ---------------------------------------------------------

# --- Image generation ---
GOOGLE_API_KEY=                # required — free tier: aistudio.google.com/apikey
GENAI_MODEL=gemini-3.1-flash-lite-image   # verify this string against Google's current model list before deploying
IMAGE_QUALITY=high
OPENAI_API_KEY=                # optional — only needed for user_plan="paid" -> dalle3
STABILITY_API_KEY=             # optional — only needed for user_plan="paid" -> stable_diffusion

# --- Planning / ideation LLM ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# --- Research (business_research_node) ---
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
BRAVE_SEARCH_MCP_URL=https://mcp.brave.com/mcp     # override if self-hosting
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/mcp    # override if self-hosting

# --- Calendar (calendar_scheduling_node) ---
CALENDAR_MCP_URL=              # your chosen calendar MCP server's endpoint
CALENDAR_MCP_API_KEY=

# --- Ad platform publishing ---
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_AD_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_OAUTH_TOKEN=

# --- Persistence / cron ---
POSTGRES_CONN_STRING=postgresql://user:password@host:5432/dbname?sslmode=require
REDIS_URL=redis://default:password@host:6379       # Celery broker/backend
