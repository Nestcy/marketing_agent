# ---------------------------------------------------------
# Copy to .env for local dev. On Railway, set these as service
# Variables on ALL THREE services (web / worker / beat) — they share
# state via Postgres/Redis and all need the same keys.
# ---------------------------------------------------------

# --- Image generation ---
GOOGLE_API_KEY=                # required — free tier: aistudio.google.com/apikey
GENAI_MODEL=gemini-2.5-flash-image   # verify against Google's current model list before deploying
IMAGE_QUALITY=high
OPENAI_API_KEY=                # optional — only needed for user_plan="paid" -> dalle3
STABILITY_API_KEY=             # optional — only needed for user_plan="paid" -> stable_diffusion

# --- Planning / ideation LLM ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile   # tool-calling reliability matters here

# --- Research (business_research_node) — direct REST, no MCP ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# --- Organic posting (publisher_clients.py) ---
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=            # posting not yet implemented — see publisher_clients.py

# --- Persistence / cron ---
POSTGRES_CONN_STRING=postgresql://user:password@host:5432/dbname?sslmode=require
REDIS_URL=redis://default:password@host:6379
